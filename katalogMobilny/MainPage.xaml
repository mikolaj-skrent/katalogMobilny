<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="katalogMobilny.MainPage">

    <ScrollView>
        <Grid Padding="20"
              RowSpacing="8"
              ColumnSpacing="8">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   x:Name="NazwaProduktuLabel"
                   Text="Procesor"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#008BFF"
                   HorizontalOptions="Center"
                   Margin="0,20"/>

            <Image Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   x:Name="ProduktImage"
                   Source="procesor.jpg"
                   Aspect="AspectFit" />

            <Label Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   x:Name="CenaProduktuLabel"
                   Text="Cena: 899 zł"
                   TextColor="Gray" />

            <Label Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   x:Name="EtykietaWyniku"
                   Text="Nic nie wybrano" />

            <Button Grid.Row="5"
                    Grid.Column="0"
                    x:Name="PokazButton"
                    Text="Pokaż"
                    HeightRequest="48"
                    Clicked="PokazClicked"/>

            <Button Grid.Row="5"
                    Grid.Column="1"
                    x:Name="UkryjButton"
                    Text="Ukryj"
                    HeightRequest="48"
                    Clicked="UkryjClicked"/>

            <FlexLayout Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        x:Name="KategorieLayout"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        Padding="10">

                <Button x:Name="ProcesoryButton"
                        Text="Procesory"
                        HeightRequest="44"
                        Margin="4"/>

                <Button x:Name="PlytyButton"
                        Text="Płyty główne"
                        HeightRequest="44"
                        Margin="4"/>

                <Button x:Name="KartyButton"
                        Text="Karty graficzne"
                        HeightRequest="44"
                        Margin="4"/>

                <Button x:Name="DyskiButton"
                        Text="Dyski SSD"
                        HeightRequest="44"
                        Margin="4"/>

                <Button x:Name="PamieciButton"
                        Text="Pamięci RAM"
                        HeightRequest="44"
                        Margin="4"/>

            </FlexLayout>

        </Grid>
    </ScrollView>

</ContentPage>
