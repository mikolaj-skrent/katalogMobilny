<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="katalogMobilny.NewProductPage"
             Title="Nowy produkt">

    <ScrollView>
        <Grid Padding="20"
              RowSpacing="8"
              ColumnSpacing="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Grid.ColumnSpan="2"
                   x:Name="TytulLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   Text="Nowy produkt"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <Label Grid.Row="1"
                   Grid.Column="0"
                   x:Name="NazwaLabel"
                   Text="Nazwa" />

            <Entry Grid.Row="1"
                   Grid.Column="1"
                   x:Name="NazwaEntry"
                   HeightRequest="44"
                   Placeholder="Wpisz nazwę produktu"
                   TextChanged="NazwaEntry_TextChanged"
                   Completed="NazwaEntry_Completed" />

            <Label Grid.Row="2"
                   Grid.Column="0"
                   x:Name="CenaLabel"
                   Text="Cena" />

            <Entry Grid.Row="2"
                   Grid.Column="1"
                   x:Name="CenaEntry"
                   HeightRequest="44"
                   Placeholder="0"
                   Keyboard="Numeric"
                   TextChanged="CenaEntry_TextChanged" />

            <Label Grid.Row="3"
                   Grid.Column="0"
                   x:Name="IloscLabel"
                   Text="Ilość" />

            <Entry Grid.Row="3"
                   Grid.Column="1"
                   x:Name="IloscEntry"
                   HeightRequest="44"
                   Placeholder="0"
                   Keyboard="Numeric" />

            <Label Grid.Row="4"
                   Grid.ColumnSpan="2"
                   x:Name="KategoriaLabel"
                   Text="Kategoria" />

            <Picker Grid.Row="5"
                    Grid.ColumnSpan="2"
                    x:Name="KategoriaPicker"
                    HeightRequest="44"
                    SelectedIndexChanged="KategoriaPicker_SelectedIndexChanged">

                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Procesory</x:String>
                        <x:String>Płyty główne</x:String>
                        <x:String>Karty graficzne</x:String>
                        <x:String>Dyski SSD</x:String>
                        <x:String>Pamięci RAM</x:String>
                    </x:Array>
                </Picker.ItemsSource>

            </Picker>

            <Switch Grid.Row="6"
                    Grid.Column="0"
                    x:Name="AvailableSwitch"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    Toggled="AvailableSwitch_Toggled" />

            <Label Grid.Row="6"
                   Grid.Column="1"
                   x:Name="DostepnoscLabel"
                   Text="Produkt niedostępny"
                   VerticalOptions="Center" />

            <Button Grid.Row="7"
                    Grid.Column="0"
                    x:Name="DodajProduktButton"
                    Text="Dodaj produkt"
                    HeightRequest="48"
                    Clicked="NowyProdukt_Clicked" />

            <Button Grid.Row="7"
                    Grid.Column="1"
                    x:Name="PowrotButton"
                    Text="Powrót"
                    HeightRequest="48"
                    Clicked="Powrot_Clicked" />

            <Label Grid.Row="8"
                   Grid.ColumnSpan="2"
                   x:Name="EtykietaWyniku" />

        </Grid>
    </ScrollView>
</ContentPage>
